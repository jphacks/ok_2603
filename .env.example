# Backend only. Never prefix these with VITE_.
GEMINI_API_KEY=
# Gemini API has no request parameter that pins a key to the free quota.
# Set true only after confirming this key's project is on the Gemini API free tier.
GEMINI_FREE_TIER_CONFIRMED=false
ADMIN_API_TOKEN=
DATABASE_PATH=./data/elections.sqlite
API_PORT=8787
DAILY_TOKEN_LIMIT=50000
COLLECTION_INTERVAL_HOURS=24
COLLECTION_SCHEDULE_ENABLED=false
COLLECTION_ON_START=true
# Local-only preview of matched candidate portraits. Public serving still requires photo_reuse_status=approved.
PHOTO_PREVIEW_ENABLED=false
